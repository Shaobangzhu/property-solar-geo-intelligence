generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id               String   @id @default(cuid())
  normalizedAddress String   @unique
  displayAddress   String
  latitude         Decimal  @db.Decimal(9, 6)
  longitude        Decimal  @db.Decimal(9, 6)
  propertyType     String?
  yearBuilt        Int?
  livingAreaSqFt   Decimal? @db.Decimal(12, 2)
  lotSizeSqFt      Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  roofProfile      RoofProfile?
  solarSystem      SolarSystemConfiguration?
  monthlyBills     MonthlyElectricityBill[]
}

model RoofProfile {
  id                     String   @id @default(cuid())
  propertyId             String   @unique
  property               Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  usableAreaSqFt         Decimal? @db.Decimal(12, 2)
  tiltDegrees            Decimal  @db.Decimal(5, 2)
  azimuthDegrees         Decimal  @db.Decimal(5, 2)
  estimatedShadingFactor Decimal? @db.Decimal(4, 3)
  roofGeometryJson       Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SolarSystemConfiguration {
  id                String   @id @default(cuid())
  propertyId        String   @unique
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  preset            String
  systemCapacityKw  Decimal  @db.Decimal(10, 3)
  systemLossPercent Decimal  @db.Decimal(5, 2)
  moduleType        Int
  arrayType         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MonthlyElectricityBill {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  billAmount Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, year, month])
}
